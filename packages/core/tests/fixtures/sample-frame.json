{
  "canvas": {
    "id": "canvas",
    "name": "Sample frame",
    "width": 390,
    "height": 844,
    "fill": "#F4F4F5"
  },
  "nodes": [
    {
      "id": "card",
      "name": "Card",
      "type": "FRAME",
      "x": 16,
      "y": 16,
      "w": 358,
      "h": 120,
      "fill": "#FFFFFF",
      "cornerRadius": 12,
      "layout": {
        "direction": "VERTICAL",
        "itemSpacing": 8,
        "padding": { "left": 16, "top": 16, "right": 16, "bottom": 16 }
